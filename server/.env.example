# Copy to .env and fill in real values. Never commit .env.

# Google OAuth 2.0 client (create at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must include http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Used to sign session cookies.
SESSION_SECRET=

# Supabase project (Settings → API). Service-role key, not anon key — server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Settings → Database → Connection string). Only
# read by `npm run migrate`; the running server uses SUPABASE_* above.
DATABASE_URL=

# Toss Payments keys (https://developers.tosspayments.com/). The client key
# is public — it's served to the browser via /api/billing/config. The secret
# key never leaves the server; the confirm API uses it with Basic auth.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Optional overrides
# GOOGLE_CALLBACK_URL=http://localhost:8787/auth/google/callback
# CLIENT_ORIGIN=http://localhost:5173
